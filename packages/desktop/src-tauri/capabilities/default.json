{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions of the main window: deep links, notifications, writing to the clipboard and opening links on the local Supabase.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "deep-link:default",
    "notification:default",
    "clipboard-manager:allow-write-text",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "http://127.0.0.1:55321/*" }]
    }
  ]
}
