---
// A staged Tink conversation. Real text in the DOM (readable without motion or JS);
// the script only paces when each message appears. Olmo is a made-up brand.
const versions = [
  { bg: '#f6e7c4', sun: '#f7e14a', tilt: -8, x: 30 },
  { bg: '#fbf3dd', sun: '#f7e14a', tilt: 0, x: 30 },
  { bg: '#e3e8f1', sun: '#ffffff', tilt: 10, x: 34 },
]
---
<figure class="scene" data-scene>
  <svg class="defs" aria-hidden="true" focusable="false" width="0" height="0">
    <defs>
      <symbol id="olmo-bottle" viewBox="0 0 20 50">
        <rect x="7.5" y="0" width="5" height="4" rx="1" fill="#e2924a" />
        <path d="M7.5 4h5v4c3 1.4 3.5 3.4 3.5 6v32c0 2-1.4 3-3 3H7c-1.6 0-3-1-3-3V14c0-2.6.5-4.6 3.5-6z" fill="#2a2119" />
        <rect x="5.5" y="21" width="9" height="15" rx="1" fill="#f6f2ea" />
        <rect x="7" y="25" width="6" height="1.6" rx=".8" fill="#2a2119" />
        <rect x="7" y="29" width="4" height="1.2" rx=".6" fill="#c9c2b4" />
      </symbol>
    </defs>
  </svg>

  <div class="window">
    <div class="bar">
      <p><strong>Olmo summer launch</strong> <span>/ Instagram post</span></p>
      <p class="status" data-status>Generating</p>
    </div>

    <ol class="thread">
      <li class="msg" data-step>
        <span class="avatar a1" aria-hidden="true">M</span>
        <div>
          <p class="who">Marina <span>Brand lead</span></p>
          <p>Summer launch post for Olmo cold brew. Use the two bottle shots. Bright, not busy.</p>
          <div class="refs">
            <svg viewBox="0 0 40 40" role="img" aria-label="Reference photo: bottle, front"><rect width="40" height="40" fill="#dcd9d2" /><use href="#olmo-bottle" x="10" y="6" width="20" height="30" /></svg>
            <svg viewBox="0 0 40 40" role="img" aria-label="Reference photo: bottle, angled"><rect width="40" height="40" fill="#d3d8d4" /><use href="#olmo-bottle" x="11" y="7" width="20" height="30" transform="rotate(-12 20 20)" /></svg>
          </div>
        </div>
      </li>

      <li class="msg agent" data-step>
        <span class="avatar" aria-hidden="true"><img src="/favicon.svg" alt="" width="28" height="28" /></span>
        <div>
          <p class="who">Tink agent</p>
          <p>Making 3 versions from your references…</p>
        </div>
      </li>

      <li class="msg" data-step>
        <span class="avatar a2" aria-hidden="true">R</span>
        <div>
          <p class="who">Rafa <span>Designer</span></p>
          <p>Keep the background lighter.</p>
          <p class="meta">Sent while the agent was working. It folds this in without starting over.</p>
        </div>
      </li>

      <li class="msg agent" data-step>
        <span class="avatar" aria-hidden="true"><img src="/favicon.svg" alt="" width="28" height="28" /></span>
        <div>
          <p class="who">Tink agent</p>
          <p>3 versions with a lighter background.</p>
          <div class="versions">
            {versions.map((v, i) => (
              <svg viewBox="0 0 80 100" role="img" aria-label={`Version ${i + 1}`}>
                <rect width="80" height="100" fill={v.bg} />
                <circle cx="56" cy="30" r="17" fill={v.sun} />
                <use href="#olmo-bottle" x={v.x} y="30" width="20" height="56" transform={`rotate(${v.tilt} 40 58)`} />
                <rect x="8" y="10" width="26" height="4" rx="2" fill="#2a2119" />
                <rect x="8" y="17" width="16" height="2.4" rx="1.2" fill="#2a2119" opacity=".55" />
                <text x="10" y="94" font-size="7" font-family="Georgia, serif" fill="#2a2119">v{i + 1}</text>
              </svg>
            ))}
          </div>
        </div>
      </li>

      <li class="msg" data-step>
        <span class="avatar a1" aria-hidden="true">M</span>
        <div>
          <p class="who">Marina <span>Brand lead</span></p>
          <p><span class="tag">@Rafa</span> v2 it is. Over to you for the logo and type.</p>
          <p class="meta">Starts with @Rafa, so it goes to Rafa, not the agent.</p>
        </div>
      </li>
    </ol>

    <div class="composer" aria-hidden="true">
      <span>Message the agent</span>
      <span class="chip">Image model</span>
    </div>
  </div>

  <figcaption>
    <span>A sample conversation. Olmo is a made-up brand.</span>
    <button type="button" class="control" data-control hidden>Pause</button>
  </figcaption>
</figure>

<style>
  .scene {
    margin: 0;
    font-family: var(--ui);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .defs {
    position: absolute;
  }

  .scene {
    width: 100%;
    max-width: 36rem;
  }

  .window {
    overflow: hidden;
    border-radius: 16px;
    background: var(--sheet);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08), 0 24px 48px -16px rgb(0 0 0 / 0.25);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .bar span {
    color: var(--graphite);
  }

  .status {
    flex: none;
    padding: 0.125rem 0.625rem;
    border-radius: 999px;
    background: var(--pencil-wash);
    color: var(--pencil);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .thread {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 1rem;
    list-style: none;
  }

  .msg {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: 0.625rem;
  }

  .msg > div {
    display: grid;
    gap: 0.25rem;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .avatar img {
    border-radius: 7px;
  }

  .a1 {
    background: var(--highlight);
  }

  .a2 {
    background: var(--pencil);
    color: #fff;
  }

  .who {
    font-weight: 600;
  }

  .who span,
  .meta {
    color: var(--graphite);
    font-weight: 400;
  }

  .meta {
    font-size: 0.75rem;
  }

  .tag {
    color: var(--pencil);
    font-weight: 600;
  }

  .refs,
  .versions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .refs svg {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 6px;
  }

  .versions svg {
    flex: 1 1 0;
    min-width: 0;
    max-width: 6.5rem;
    border-radius: 8px;
    outline: 1px solid var(--rule);
  }

  .versions svg:nth-child(2) {
    outline: 2.5px solid var(--pencil);
    outline-offset: 2px;
  }

  .composer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 1rem 1rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 12px;
    color: #76766f;
  }

  .chip {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--graphite);
    font-size: 0.75rem;
  }

  /* Wide screens: a landscape 16:9 window with the thread in two columns, sized so the
     whole scene fits in one viewport. Phones keep the single vertical column. */
  @media (min-width: 52rem) {
    .scene {
      max-width: min(72rem, (100svh - 17rem) * 16 / 9);
    }

    .window {
      display: flex;
      flex-direction: column;
      aspect-ratio: 16 / 9;
      /* clip, not hidden: a scroll container would let aspect-ratio cut off the content. */
      overflow: clip;
    }

    .thread {
      flex: 1;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-content: center;
      align-items: start;
      column-gap: 2rem;
      padding: 1.25rem 1.5rem;
    }

    /* Messages 1–3 fill the left column; the versions and the hand-off sit on the right. */
    .thread > :nth-child(4) {
      grid-column: 2;
      grid-row: 1 / span 2;
    }

    .thread > :nth-child(5) {
      grid-column: 2;
      grid-row: 3;
    }

    .versions svg {
      max-width: 8.5rem;
    }

    .composer {
      margin: 0 1.5rem 1.25rem;
    }
  }

  figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
    color: var(--ink);
    font-size: 0.8125rem;
  }

  .control {
    min-height: 2.25rem;
    padding: 0 0.875rem;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius-button);
    background: transparent;
    color: var(--ink);
    font: 600 0.8125rem var(--ui);
    cursor: pointer;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) [data-scene] [data-step] {
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 0.35s ease, transform 0.35s ease;
    }

    :global(.js) [data-scene] [data-step].is-shown {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const STEP_MS = 1500

  for (const scene of document.querySelectorAll<HTMLElement>('[data-scene]')) {
    const steps = [...scene.querySelectorAll<HTMLElement>('[data-step]')]
    const control = scene.querySelector<HTMLButtonElement>('[data-control]')!
    const status = scene.querySelector<HTMLElement>('[data-status]')!
    const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)').matches

    const showAll = () => {
      steps.forEach((step) => step.classList.add('is-shown'))
      status.textContent = 'Finishing'
    }
    if (!motionOk) {
      showAll()
      continue
    }

    let shown = 0
    let timer: number | undefined
    let paused = false

    const tick = () => {
      steps[shown]?.classList.add('is-shown')
      shown += 1
      if (shown === steps.length) {
        status.textContent = 'Finishing'
        control.textContent = 'Replay'
        timer = undefined
        return
      }
      timer = window.setTimeout(tick, STEP_MS)
    }

    const play = () => {
      paused = false
      control.textContent = 'Pause'
      tick()
    }

    control.hidden = false
    control.addEventListener('click', () => {
      if (shown === steps.length) {
        // Replay from an empty thread.
        steps.forEach((step) => step.classList.remove('is-shown'))
        status.textContent = 'Generating'
        shown = 0
        play()
      } else if (paused) {
        play()
      } else {
        paused = true
        window.clearTimeout(timer)
        control.textContent = 'Play'
      }
    })

    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return
        observer.disconnect()
        play()
      },
      { threshold: 0.35 },
    )
    observer.observe(scene)
  }
</script>
