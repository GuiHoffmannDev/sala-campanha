---
// A staged Tink conversation: the window, header, composer and pacing script. Each scene passes its
// messages as <li class="msg" data-step> children (and any SVG <defs> in the "defs" slot).
// Real text stays in the DOM (readable without motion or JS); the script only paces when each message appears.
interface Props {
  /** Campaign name, shown bold in the header. */
  title: string
  /** The piece being made, shown after the title. */
  piece: string
  /** Header status while messages are still arriving, and once they all have. */
  startStatus?: string
  endStatus?: string
  caption?: string
  /** Landscape 16:9 window with a two-column thread on wide screens. Laid out for exactly five messages. */
  wide?: boolean
}

const {
  title,
  piece,
  startStatus = 'Generating',
  endStatus = 'Finishing',
  caption = 'A sample conversation. Olmo is a made-up brand.',
  wide = false,
} = Astro.props
---
<figure class:list={['scene', { wide }]} data-scene data-start-status={startStatus} data-end-status={endStatus}>
  <slot name="defs" />

  <div class="window">
    <div class="bar">
      <p><strong>{title}</strong> <span>/ {piece}</span></p>
      <p class="status" data-status>{startStatus}</p>
    </div>

    <ol class="thread">
      <slot />
    </ol>

    <div class="composer" aria-hidden="true">
      <span>Message the agent</span>
      <span class="chip">Image model</span>
    </div>
  </div>

  <figcaption>
    <span>{caption}</span>
    <button type="button" class="control" data-control hidden>Pause</button>
  </figcaption>
</figure>

<style>
  /* Messages come from the scene that uses this component, so their rules are :global under .scene. */
  .scene {
    width: 100%;
    max-width: 36rem;
    margin: 0;
    font-family: var(--ui);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .scene :global(.defs) {
    position: absolute;
  }

  .window {
    overflow: hidden;
    border-radius: 16px;
    background: var(--sheet);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08), 0 24px 48px -16px rgb(0 0 0 / 0.25);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .bar span {
    color: var(--graphite);
  }

  .status {
    flex: none;
    padding: 0.125rem 0.625rem;
    border-radius: 999px;
    background: var(--pencil-wash);
    color: var(--pencil);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .thread {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 1rem;
    list-style: none;
  }

  .scene :global(.msg) {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: 0.625rem;
  }

  .scene :global(.msg > div) {
    display: grid;
    gap: 0.25rem;
  }

  .scene :global(.avatar) {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .scene :global(.avatar img) {
    border-radius: 7px;
  }

  .scene :global(.a1) {
    background: var(--highlight);
  }

  .scene :global(.a2) {
    background: var(--pencil);
    color: #fff;
  }

  .scene :global(.who) {
    font-weight: 600;
  }

  .scene :global(.who span),
  .scene :global(.meta) {
    color: var(--graphite);
    font-weight: 400;
  }

  .scene :global(.meta) {
    font-size: 0.75rem;
  }

  .scene :global(.tag) {
    color: var(--pencil);
    font-weight: 600;
  }

  .scene :global(.refs),
  .scene :global(.versions) {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .scene :global(.refs svg) {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 6px;
  }

  .scene :global(.versions svg) {
    flex: 1 1 0;
    min-width: 0;
    max-width: 6.5rem;
    border-radius: 8px;
    outline: 1px solid var(--rule);
  }

  /* The version someone picked. */
  .scene :global(.versions .picked) {
    outline: 2.5px solid var(--pencil);
    outline-offset: 2px;
  }

  .composer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 1rem 1rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 12px;
    color: #76766f;
  }

  .chip {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--graphite);
    font-size: 0.75rem;
  }

  /* Wide scenes on wide screens: a landscape 16:9 window with the thread in two columns, sized so the
     whole scene fits in one viewport. Phones keep the single vertical column. */
  @media (min-width: 52rem) {
    .wide {
      max-width: min(72rem, (100svh - 17rem) * 16 / 9);
    }

    .wide .window {
      display: flex;
      flex-direction: column;
      aspect-ratio: 16 / 9;
      /* clip, not hidden: a scroll container would let aspect-ratio cut off the content. */
      overflow: clip;
    }

    .wide .thread {
      flex: 1;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-content: center;
      align-items: start;
      column-gap: 2rem;
      padding: 1.25rem 1.5rem;
    }

    /* Messages 1–3 fill the left column; messages 4 and 5 sit on the right. */
    .wide .thread > :global(:nth-child(4)) {
      grid-column: 2;
      grid-row: 1 / span 2;
    }

    .wide .thread > :global(:nth-child(5)) {
      grid-column: 2;
      grid-row: 3;
    }

    .wide :global(.versions svg) {
      max-width: 8.5rem;
    }

    .wide .composer {
      margin: 0 1.5rem 1.25rem;
    }
  }

  figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
    color: var(--ink);
    font-size: 0.8125rem;
  }

  .control {
    min-height: 2.25rem;
    padding: 0 0.875rem;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius-button);
    background: transparent;
    color: var(--ink);
    font: 600 0.8125rem var(--ui);
    cursor: pointer;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) [data-scene] :global([data-step]) {
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 0.35s ease, transform 0.35s ease;
    }

    :global(.js) [data-scene] :global([data-step].is-shown) {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const STEP_MS = 1500

  for (const scene of document.querySelectorAll<HTMLElement>('[data-scene]')) {
    const steps = [...scene.querySelectorAll<HTMLElement>('[data-step]')]
    const control = scene.querySelector<HTMLButtonElement>('[data-control]')!
    const status = scene.querySelector<HTMLElement>('[data-status]')!
    const { startStatus = '', endStatus = '' } = scene.dataset
    const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)').matches

    const showAll = () => {
      steps.forEach((step) => step.classList.add('is-shown'))
      status.textContent = endStatus
    }
    if (!motionOk) {
      showAll()
      continue
    }

    let shown = 0
    let timer: number | undefined
    let paused = false

    const tick = () => {
      steps[shown]?.classList.add('is-shown')
      shown += 1
      if (shown === steps.length) {
        status.textContent = endStatus
        control.textContent = 'Replay'
        timer = undefined
        return
      }
      timer = window.setTimeout(tick, STEP_MS)
    }

    const play = () => {
      paused = false
      control.textContent = 'Pause'
      tick()
    }

    control.hidden = false
    control.addEventListener('click', () => {
      if (shown === steps.length) {
        // Replay from an empty thread.
        steps.forEach((step) => step.classList.remove('is-shown'))
        status.textContent = startStatus
        shown = 0
        play()
      } else if (paused) {
        play()
      } else {
        paused = true
        window.clearTimeout(timer)
        control.textContent = 'Play'
      }
    })

    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return
        observer.disconnect()
        play()
      },
      { threshold: 0.35 },
    )
    observer.observe(scene)
  }
</script>
