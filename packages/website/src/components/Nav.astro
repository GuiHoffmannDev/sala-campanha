---
import Logo from './Logo.astro'
import ProductIcon from './ProductIcon.astro'
import { PRIMARY_NAV } from '../data/site.ts'
import { PRODUCTS } from '../data/products.ts'

const current = Astro.url.pathname.replace(/\/$/, '') || '/'
const isCurrent = (href: string) => current.startsWith(href)
---
<header class="nav wrap">
  <Logo />
  <nav aria-label="Main">
    <button class="toggle" type="button" aria-expanded="false" aria-controls="nav-links">Menu</button>
    <ul id="nav-links">
      {PRIMARY_NAV.map((item) =>
        item.href === '/products' ? (
          <li class="has-menu">
            <button class="menu-button" type="button" aria-expanded="false" aria-controls="products-menu">
              Products
              <svg aria-hidden="true" viewBox="0 0 10 6" width="10" height="6"><path d="M1 1l4 4 4-4" /></svg>
            </button>
            <ul class="submenu" id="products-menu">
              {PRODUCTS.map((product) => (
                <li>
                  {'soon' in product ? (
                    <div class="item soon">
                      <ProductIcon slug={product.slug} color={product.color} />
                      <strong>{product.name} <em class="badge">Soon</em></strong>
                      <span>{product.summary}</span>
                    </div>
                  ) : (
                    <a class="item" href={`/products/${product.slug}`} aria-current={isCurrent(`/products/${product.slug}`) ? 'page' : undefined}>
                      <ProductIcon slug={product.slug} color={product.color} />
                      <strong>{product.name}</strong>
                      <span>{product.summary}</span>
                    </a>
                  )}
                </li>
              ))}
              <li class="all"><a href="/products">All products</a></li>
            </ul>
          </li>
        ) : (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ),
      )}
      <li class="cta"><a class="button" href="#waitlist">Join waitlist</a></li>
    </ul>
  </nav>
</header>

<style>
  .nav {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #nav-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    font-size: 0.9375rem;
  }

  a:not(.button),
  .menu-button {
    text-decoration: none;
  }

  #nav-links > li > a:not(.button):hover,
  .menu-button:hover,
  [aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--pencil);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  .menu-button {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .menu-button path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .menu-button[aria-expanded='true'] svg {
    rotate: 180deg;
  }

  .has-menu {
    position: relative;
  }

  .submenu {
    position: absolute;
    left: -1rem;
    top: calc(100% + 0.75rem);
    display: none;
    width: 38rem;
    padding: 0.5rem;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: var(--sheet);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.08);
  }

  /* Opens on click with JS (keeps aria-expanded true to state); hover or focus is the no-JS fallback. */
  :global(html:not(.js)) .has-menu:hover .submenu,
  :global(html:not(.js)) .has-menu:focus-within .submenu,
  .submenu.is-open {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .submenu .all {
    grid-column: 1 / -1;
  }

  /* Bridge the gap so the menu stays open while the pointer moves into it. */
  .has-menu::after {
    content: '';
    position: absolute;
    inset: 100% -1rem auto;
    height: 0.75rem;
  }

  .submenu a {
    display: grid;
    gap: 0.125rem;
    padding: 0.75rem;
    border-radius: 8px;
  }

  .submenu a:hover {
    background: #f4f4f2;
  }

  /* Mini logo on the left, name and summary stacked beside it. */
  .submenu .item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.75rem;
    row-gap: 0.125rem;
    padding: 0.75rem;
  }

  .item :global(.product-icon) {
    grid-row: span 2;
  }

  .submenu strong {
    font-weight: 600;
  }

  .soon strong {
    color: var(--graphite);
  }

  .badge {
    margin-left: 0.25rem;
    padding: 0.0625rem 0.5rem;
    border-radius: 999px;
    background: var(--pencil-wash);
    color: var(--pencil);
    font-size: 0.6875rem;
    font-style: normal;
    font-weight: 600;
    vertical-align: 0.1em;
  }

  .submenu span {
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .submenu .all a {
    color: var(--graphite);
    font-size: 0.875rem;
  }

  .cta {
    margin-left: 0.5rem;
  }

  .cta .button {
    min-height: 2.5rem;
    padding: 0 1.125rem;
    font-size: 0.9375rem;
  }

  .toggle {
    display: none;
  }

  @media (max-width: 60rem) {
    nav {
      position: relative;
    }

    .toggle {
      display: inline-flex;
      min-height: 2.75rem;
      align-items: center;
      padding: 0 1rem;
      border: 1px solid var(--ink);
      border-radius: var(--radius-button);
      background: transparent;
      color: var(--ink);
      font: 500 0.9375rem var(--sans);
      cursor: pointer;
    }

    #nav-links {
      position: absolute;
      right: 0;
      top: calc(100% + 0.5rem);
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      min-width: min(18rem, calc(100vw - 2 * var(--gutter)));
      padding: 0.5rem;
      border: 1px solid var(--rule);
      border-radius: 14px;
      background: var(--sheet);
      box-shadow: 0 12px 32px rgb(0 0 0 / 0.08);
    }

    /* Without JS the list stays open, so every link is still reachable. */
    :global(.js) #nav-links:not(.is-open) {
      display: none;
    }

    #nav-links > li > a:not(.button),
    .menu-button {
      display: flex;
      width: 100%;
      padding: 0.75rem;
    }

    /* On small screens the products list sits inline instead of floating. */
    .menu-button {
      display: none;
    }

    .submenu,
    .submenu.is-open {
      position: static;
      display: block;
      width: auto;
      padding: 0;
      border: 0;
      box-shadow: none;
    }

    .has-menu::after {
      display: none;
    }

    .cta {
      margin: 0.25rem 0 0;
    }

    .cta .button {
      width: 100%;
      min-height: 3rem;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav .toggle')
  const links = document.getElementById('nav-links')
  const menuButton = document.querySelector<HTMLButtonElement>('.nav .menu-button')
  const submenu = document.getElementById('products-menu')

  const setMenu = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open))
    links?.classList.toggle('is-open', open)
  }
  const setSubmenu = (open: boolean) => {
    menuButton?.setAttribute('aria-expanded', String(open))
    submenu?.classList.toggle('is-open', open)
  }

  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'))
  menuButton?.addEventListener('click', () => setSubmenu(menuButton.getAttribute('aria-expanded') !== 'true'))

  links?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) {
      setMenu(false)
      setSubmenu(false)
    }
  })

  document.addEventListener('click', (event) => {
    if (!(event.target as HTMLElement).closest('.has-menu')) setSubmenu(false)
  })

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return
    if (submenu?.classList.contains('is-open')) {
      setSubmenu(false)
      menuButton?.focus()
    } else if (links?.classList.contains('is-open')) {
      setMenu(false)
      toggle?.focus()
    }
  })
</script>
