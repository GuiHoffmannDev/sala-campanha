---
import Base from '../layouts/Base.astro'
import Scribble from '../components/Scribble.astro'
import LaunchScene from '../components/LaunchScene.astro'
import HeroCollage from '../components/HeroCollage.astro'
import PatternFrame from '../components/PatternFrame.astro'
import Comparison from '../components/Comparison.astro'
---
<Base>
  <section class="hero wrap" aria-labelledby="hero-title">
    <h1 id="hero-title">
      Your campaign,
      <span class="edit">
        <Scribble kind="strike" delay={0.5} replay><span aria-hidden="true">back and forth</span></Scribble>
        <ins class="serif">in one room.</ins>
      </span>
    </h1>
    <PatternFrame pattern="stripes" class="hero-frame">
      <HeroCollage />
    </PatternFrame>
    <a class="big-cta" href="#waitlist">Join waitlist</a>
    <p class="duo">
      Brief, make and approve every piece together.
      <span class="rest">Your brand team and AI agents share one conversation, so nobody has to relay requests anymore.</span>
    </p>
  </section>

  <section class="wrap" aria-label="Tink Room in action">
    <PatternFrame pattern="cubes" fill="var(--sky)">
      <div class="center"><LaunchScene /></div>
    </PatternFrame>

    <ol class="steps">
      <li>
        <svg class="shape" aria-hidden="true" viewBox="0 0 16 16"><circle cx="8" cy="8" r="7" fill="#2e221e" /></svg>
        <h3>Ask in the open</h3>
        <p>
          Describe the piece and attach references from the campaign’s photo library. Every message goes to the agent,
          unless it starts with <span class="at">@someone</span>.
        </p>
      </li>
      <li>
        <svg class="shape" aria-hidden="true" viewBox="0 0 16 16"><rect x="1" y="1" width="14" height="14" fill="#e2924a" /></svg>
        <h3>Steer while it works</h3>
        <p>
          Anyone can redirect mid-generation, like “lighter background”, and the agent folds it in without starting
          over. Image and copy versions land right in the thread.
        </p>
      </li>
      <li>
        <svg class="shape" aria-hidden="true" viewBox="0 0 16 16"><path d="M8 .8c.7 4.1 2.4 6 6.5 7.2-4.1 1.2-5.8 3.1-6.5 7.2-.7-4.1-2.4-6-6.5-7.2C5.6 6.8 7.3 4.9 8 .8z" fill="#f7e14a" stroke="#2e221e" stroke-width="1" stroke-linejoin="round" /></svg>
        <h3>Approve, then finish</h3>
        <p>
          The lead approves a base version. The designer finishes it in Photoshop, uploads the final, and gets comments
          pinned to the exact spot.
        </p>
      </li>
    </ol>
  </section>

  <section class="wrap" aria-labelledby="relay-title">
    <h2 id="relay-title">Somebody always ends up as the relay.</h2>
    <p class="lede">
      The request lands in one chat. The designer turns it into a prompt in another tool, exports, sends it back.
      <span class="mark serif nowrap">“Not quite.”</span> Another round. The person who asked never sees the prompt,
      the versions that didn’t make it, or why. Tink takes the relay out.
    </p>
  </section>

  <section class="compare-band" aria-labelledby="compare-title">
    <div class="wrap">
      <h2 id="compare-title">The relay, or the room.</h2>
      <Comparison />
    </div>
  </section>

  <section class="wrap" aria-labelledby="keys-title">
    <h2 id="keys-title">
      Your <span class="nowrap"><Scribble kind="underline" replay>keys</Scribble>.</span> Your models.
    </h2>
    <p class="lede">Your workspace admin adds API keys once, for the AI providers you already pay for, and the whole team works with them.</p>

    <PatternFrame pattern="stripes" fill="var(--orange)" class="keys-frame">
      <div class="center">
      <div class="keys-card" aria-hidden="true">
        <p class="card-title">Workspace keys</p>
        <ul>
          <li><span class="dot"></span><span>Text model provider</span><span class="state">Added</span></li>
          <li><span class="dot"></span><span>Image model provider</span><span class="state">Added</span></li>
        </ul>
        <div class="picker">
          <span>Model for this request</span>
          <span class="chip">Image model</span>
        </div>
      </div>
      </div>
    </PatternFrame>

    <p class="lede">Pick the model for each request. Tink doesn’t resell AI usage: you pay your providers directly, at their prices.</p>
  </section>

  <section class="wrap products" aria-labelledby="products-title">
    <div>
      <h2 id="products-title">Room is the first Tink product.</h2>
      <p class="lede">More are on the way.</p>
    </div>
    <a class="button" href="/products/room">Explore Room</a>
  </section>
</Base>

<style>
  .nowrap {
    white-space: nowrap;
  }

  section.wrap {
    padding-block: clamp(3rem, 2rem + 4vw, 6rem);
  }

  /* Hero */
  section.hero {
    display: grid;
    gap: 2rem;
    padding-block: clamp(3rem, 2rem + 6vw, 8rem) clamp(2rem, 1rem + 3vw, 4rem);
  }

  h1 {
    max-width: 15ch;
  }

  /* Figma-style hero: headline left, collage in the middle, signup right; the pitch sits below. */
  @media (min-width: 64rem) {
    section.hero {
      grid-template-columns: minmax(0, 1.4fr) auto minmax(0, 1fr);
      align-items: center;
      column-gap: clamp(1.5rem, 4vw, 5rem);
    }

    h1 {
      font-size: clamp(2.5rem, 0.6rem + 3vw, 4.25rem);
    }

    .big-cta {
      justify-self: end;
    }

    .hero .duo {
      grid-column: 1 / -1;
      margin-top: 2rem;
    }
  }

  /* Figma-style hero button: one big, plain action that jumps to the signup form. */
  .big-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    justify-self: start;
    min-height: 3.5rem;
    padding: 0.875rem 2.25rem;
    border-radius: var(--radius-button);
    background: var(--ink);
    color: var(--paper);
    font-size: clamp(1.25rem, 0.85rem + 1.1vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s ease;
  }

  .big-cta:hover {
    background: var(--pencil);
  }

  ins {
    color: var(--pencil);
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) ins {
      display: inline-block;
      clip-path: inset(0 100% 0 0);
      transition: clip-path 0.7s cubic-bezier(0.65, 0, 0.35, 1) 1.15s;
    }

    :global(.js) .edit:has(.is-drawn) ins {
      clip-path: inset(0 0 -0.2em 0);
    }
  }

  .hero .duo {
    max-width: 38rem;
  }

  /* Framed stages */
  .center {
    display: grid;
    place-items: center;
  }

  .hero :global(.hero-frame .panel) {
    padding: clamp(0.5rem, 0.25rem + 1vw, 1rem);
  }

  .keys-frame {
    margin-top: 2.5rem;
  }

  .lede .mark {
    color: var(--ink);
  }

  /* Steps below the stage: a real sequence, marked with simple shapes. */
  .steps {
    display: grid;
    gap: 2rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    display: grid;
    gap: 0.375rem;
    align-content: start;
  }

  .shape {
    width: 0.875rem;
    height: 0.875rem;
    margin-bottom: 0.5rem;
  }

  .steps p {
    max-width: 24rem;
    color: var(--muted);
    font-size: 1rem;
  }

  .at {
    color: var(--pencil);
    font-weight: 600;
  }

  @media (min-width: 52rem) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  h2 {
    max-width: 22ch;
  }

  /* Comparison band */
  .compare-band {
    padding-block: clamp(3.5rem, 2rem + 5vw, 7rem);
    background: var(--pencil-wash);
  }

  .compare-band h2 {
    margin-bottom: 2.5rem;
  }

  /* Keys mock-up on the blue stage */
  .keys-card {
    width: 100%;
    max-width: 26rem;
    padding: 1.25rem;
    border-radius: 16px;
    background: var(--sheet);
    font-family: var(--ui);
    font-size: 0.875rem;
    box-shadow: 0 24px 48px -16px rgb(0 0 0 / 0.35);
  }

  .card-title {
    margin-bottom: 0.75rem;
    font-weight: 600;
  }

  .keys-card ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .keys-card li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--rule);
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #1a9b55;
  }

  .state {
    color: var(--muted);
  }

  .picker {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.5rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 10px;
    color: var(--muted);
  }

  .chip {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--graphite);
    font-size: 0.75rem;
  }


  /* Products */
  section.products {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    border-top: 1px solid var(--rule);
  }

</style>
